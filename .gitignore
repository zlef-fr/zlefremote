node_modules/
# ignore built dist contents, but DO track the Xfce plugin tarball — it has no
# CI build step, so it ships from the repo (agent binaries are CI-built, ignored)
dist/*
!dist/zlefremote-xfce-plugin.tar.gz
agent/web/
agent/agent
*.log
.DS_Store
panel-plugin/*.so
panel-plugin/zr-standalone
# tray build artifacts (regenerated by tray/build.sh)
tray/assets/zlefremote.ico
tray/rsrc_windows_*.syso

# the desktop client build (go build ./... drops a binary here)
desktop/desktop

# Flutter app build output (the APK is published to dist/app by scripts/release.sh)
app/build/
app/.dart_tool/
app/android/key.properties
app/android/local.properties
app/android/.gradle/
app/.flutter-plugins-dependencies
